{
  "$schema": "../../shared/pipeline.schema.json",
  "id": "brief-to-screen",
  "pattern": "evaluator-optimizer",
  "description": "Generate a screen and iterate against two evaluators — accessibility (AA) and design quality (shared/design-quality.md §8) — until both gates pass.",
  "maxIterations": 4,
  "steps": [
    {
      "id": "generate",
      "skill": "penpot-build-screen",
      "inputs": [
        "brief",
        "designSystem",
        "viewport"
      ],
      "checkpoint": true,
      "next": "evaluate",
      "on_fail": "halt"
    },
    {
      "id": "evaluate",
      "skill": "penpot-audit-accessibility",
      "inputs": [
        "scope:screen"
      ],
      "checkpoint": false,
      "next": "decide",
      "on_fail": "report"
    },
    {
      "id": "decide",
      "type": "branch",
      "if": "evaluate.highOrMedium == 0 && generate.designQuality.belowThreshold == 0",
      "thenNext": "done",
      "elseNext": "generate",
      "elseInputs": [
        "fixIssues:evaluate.findings",
        "fixDesign:generate.designQuality.findings"
      ]
    }
  ],
  "exit": "AA pass (no High/Medium) AND design-quality pass (no axis < 3) OR maxIterations reached -> present remaining issues + weak axes",
  "output": "report: { screenId, iterations, finalA11y, finalDesignQuality }"
}
