# Copy to `loci.env` and fill in. `loci.env` is gitignored and kept out of the
# Docker build context, so nothing here is ever baked into an image layer.
#
#   cp loci.env.example loci.env
#   docker compose up
#
# Or without compose:
#   docker run -p 7777:7777 -v loci-data:/data --env-file loci.env loci

# Refused out loud when missing: the agent answers "no DeepSeek key".
DEEPSEEK_API_KEY=

# Fails QUIETLY when missing — it falls back to deepseek-v4-flash, which is
# very likely not the model you run locally. Set it whenever you set the key.
DEEPSEEK_MODEL=deepseek-v4-pro

# Optional. Without it, research still runs but with no web search behind it.
TAVILY_API_KEY=

# Where the substrate lives INSIDE the container. compose mounts a named volume
# here; change it only if you also change the mount.
LOCI_DATA=/data

# Deliberately not set here. The container listens on 7777 and compose publishes
# 7777; setting PORT would move the listener without moving the mapping, leaving
# a container that looks healthy and answers nothing.
# PORT=7777
