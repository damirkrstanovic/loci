{:paths ["src" "resources"]
 :deps {org.clojure/clojure    {:mvn/version "1.12.0"}
        http-kit/http-kit      {:mvn/version "2.8.0"}
        org.clojure/data.json  {:mvn/version "2.5.0"}
        ;; SPIKE 2026-08-25 — Transit on one route, to see whether a namespaced
        ;; keyword survives the wire. JSON silently renames :table/total to "total".
        com.cognitect/transit-clj {:mvn/version "1.0.333"}
        ;; org.clojure/data.csv is gone as of 2026-08-20. DuckDB's `read_csv` is
        ;; the only CSV reader loci has; `loci.corpus` was the last namespace
        ;; parsing one itself, and it now imports through the file connector.
        org.babashka/sci       {:mvn/version "0.8.43"}
        datalevin/datalevin    {:mvn/version "1.0.0"}
        org.duckdb/duckdb_jdbc {:mvn/version "1.5.5.1"}}

 ;; **`-Djava.io.tmpdir=.tmp` on every alias that RUNS loci, and it is RELATIVE.**
 ;;
 ;; /tmp on the machine this was built on is a 7.8 GB tmpfs on a 15 GB box, so
 ;; everything written there is RAM. DuckDB's JDBC driver extracts a 58 MB native
 ;; library into java.io.tmpdir on every JVM start, and the browser harness makes
 ;; a temp directory per server. Both clean up on a GRACEFUL exit and neither
 ;; gets one when a run is killed. Measured 2026-08-20: /tmp reached 100%
 ;; mid-session and stopped the build, holding ~4 GB of leaked libraries and
 ;; 9,918 fixture directories. It had already distorted two measurements — see
 ;; the 2026-08-08 Datahike bench and phase 1's 10M-row gate, which reached for
 ;; /var/tmp by hand.
 ;;
 ;; Relative because deps.edn cannot interpolate a path, and `clojure` always
 ;; runs from the directory holding this file. **The consequence to know:**
 ;; `(str (System/getProperty "java.io.tmpdir") "/x")` is now a relative
 ;; path, which is fine as a path and NOT fine concatenated after `file://` — a
 ;; file URI needs an absolute path or the first segment reads as a host. Build
 ;; one with `(.getAbsolutePath (io/file tmp name))`. That caught
 ;; `loci.source-test`'s parquet fixture on the day this landed. `locate` now
 ;; refuses such a URI outright rather than resolving it — see `loci.sourcespec`.
 ;;
 ;; **`:build` is the exception, and wants to be.** Its JVM runs tools.build and
 ;; never opens DuckDB, so nothing extracts the 58 MB native library there. The
 ;; AOT compile that DOES load loci runs in a JVM `compile-clj` forks, which
 ;; takes its flags from build.clj's `:java-opts` and inherits nothing from here.
 ;; What the property would move is tools.build's own compile working directory,
 ;; which it hands to that subprocess as a classpath entry and assumes absolute —
 ;; so setting it here buys nothing and risks the paragraph above.
 :aliases
 ;; the loci shell — Clojure substrate served to a web frontend
 ;; run:  clojure -M:serve   then open http://localhost:7777
 {:serve {:main-opts ["-m" "loci.server"]
          :jvm-opts  ["--enable-native-access=ALL-UNNAMED" "-Djava.io.tmpdir=.tmp"]}

  ;; headless demo of layers 1/2/4 — no server, no browser
  :demo  {:main-opts ["-m" "loci.demo"]
          :jvm-opts  ["--enable-native-access=ALL-UNNAMED" "-Djava.io.tmpdir=.tmp"]}

  ;; run the unit tests:  clojure -M:test
  :test  {:extra-paths ["test"]
          :extra-deps  {io.github.cognitect-labs/test-runner
                        {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
          :main-opts   ["-m" "cognitect.test-runner"]
          :jvm-opts    ["--enable-native-access=ALL-UNNAMED" "-Djava.io.tmpdir=.tmp"]}

  ;; one-shot import of the old EDN log into Datalevin:  clojure -M:migrate
  :migrate {:main-opts ["-m" "loci.migrate"]
            :jvm-opts  ["--enable-native-access=ALL-UNNAMED" "-Djava.io.tmpdir=.tmp"]}

  ;; re-measure the merge threshold after changing LOCI_EMBED_MODEL — a
  ;; threshold belongs to one embedding model and does not travel:
  ;;   clojure -M:calibrate path/to/memory.edn
  ;; The path is required; there is no default, so this cannot be pointed at
  ;; your real memory by accident. It reads and never writes.
  :calibrate {:main-opts ["-m" "loci.calibrate"]
              :jvm-opts  ["--enable-native-access=ALL-UNNAMED" "-Djava.io.tmpdir=.tmp"]}

  ;; an nREPL for editor/agent tooling (ClojureMCP starts this itself via
  ;; :start-nrepl-cmd). Deliberately WITHOUT :extra-paths ["dev"] — a REPL that
  ;; loads user.clj is one keystroke from serving Clerk over the real notebooks.
  ;; Native access because anything worth evaluating here reaches loci.dlv.
  ;;
  ;; `test` IS on the path, and that is the difference between a REPL that can
  ;; run this project's tests and one that can only look at its source. Without
  ;; it, `(require 'loci.factlog-test)` fails and every test run costs a fresh
  ;; JVM: measured 2026-08-15, ~25 s of startup (14 s of it Datalevin) to reach
  ;; work that takes milliseconds warm. `test` carries no user.clj, so it does
  ;; not reintroduce what the "dev" exclusion above is guarding against.
  ;;   clojure -M:nrepl
  :nrepl {:extra-paths ["test"]
          :extra-deps  {nrepl/nrepl {:mvn/version "1.3.1"}}
          :main-opts   ["-m" "nrepl.cmdline" "--port" "7888"]
          :jvm-opts    ["--enable-native-access=ALL-UNNAMED" "-Djava.io.tmpdir=.tmp"]}

  ;; Clerk notebook (the earlier render target). Both reach the substrate
  ;; through notebooks/loci.clj, so both need the native-access flag too.
  :dev   {:extra-paths ["dev" "notebooks"]
          :extra-deps  {io.github.nextjournal/clerk {:mvn/version "0.17.1102"}}
          :jvm-opts    ["--enable-native-access=ALL-UNNAMED" "-Djava.io.tmpdir=.tmp"]}
  :start {:extra-paths ["dev" "notebooks"]
          :extra-deps  {io.github.nextjournal/clerk {:mvn/version "0.17.1102"}}
          :jvm-opts    ["--enable-native-access=ALL-UNNAMED" "-Djava.io.tmpdir=.tmp"]
          :exec-fn     user/start}

  ;; The ClojureScript shell.
  ;;   compile:  clojure -M:cljs -m shadow.cljs.devtools.cli release grid
  ;;   watch:    clojure -M:cljs -m shadow.cljs.devtools.cli watch grid
  ;; `src-cljs` and `test-cljs` are their own roots so the Clojure compiler never
  ;; sees a .cljs file on `src` or `test`, and so this alias is the only thing
  ;; that knows CLJS exists. `test-cljs` is here and not on `:test` because
  ;; `cljs.test` runs in Node, not in the JVM suite:
  ;;   clojure -M:cljs -m shadow.cljs.devtools.cli compile test && node target/cljs-test.cjs
  ;; `:replace-deps`, NOT `:extra-deps`. The CLJS build has no business loading
  ;; Datalevin or DuckDB — and one of them bites: `datalevin/datalevin 1.0.0`
  ;; pulls `io.github.nextjournal/markdown`, whose jar carries a `deps.cljs`
  ;; declaring npm dependencies, so shadow-cljs ran `npm install --save` for
  ;; Clerk's whole markdown-it stack and rewrote package.json. Measured
  ;; 2026-08-25: six packages added to a project whose shell has none, for a
  ;; namespace the shell never requires. A clean classpath removes it at source.
  :cljs  {:replace-paths ["src-cljs" "test-cljs"]
          :replace-deps  {org.clojure/clojure        {:mvn/version "1.12.0"}
                          thheller/shadow-cljs       {:mvn/version "3.2.0"}
                          no.cjohansen/replicant     {:mvn/version "2025.06.21"}
                          com.cognitect/transit-cljs {:mvn/version "0.8.280"}}
          :jvm-opts      ["-Djava.io.tmpdir=.tmp"]}

  ;; the uberjar:  clojure -T:build uber   ->  target/loci-standalone.jar
  :build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
          :ns-default build}}}
