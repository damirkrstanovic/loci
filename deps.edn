{:paths ["src" "resources"]
 :deps {org.clojure/clojure    {:mvn/version "1.12.0"}
        http-kit/http-kit      {:mvn/version "2.8.0"}
        org.clojure/data.json  {:mvn/version "2.5.0"}
        org.clojure/data.csv   {:mvn/version "1.1.0"}
        org.babashka/sci       {:mvn/version "0.8.43"}
        datalevin/datalevin    {:mvn/version "1.0.0"}
        org.duckdb/duckdb_jdbc {:mvn/version "1.5.5.1"}}

 :aliases
 ;; the loci shell — Clojure substrate served to a web frontend
 ;; run:  clojure -M:serve   then open http://localhost:7777
 {:serve {:main-opts ["-m" "loci.server"]
          :jvm-opts  ["--enable-native-access=ALL-UNNAMED"]}

  ;; headless demo of layers 1/2/4 — no server, no browser
  :demo  {:main-opts ["-m" "loci.demo"]
          :jvm-opts  ["--enable-native-access=ALL-UNNAMED"]}

  ;; run the unit tests:  clojure -M:test
  :test  {:extra-paths ["test"]
          :extra-deps  {io.github.cognitect-labs/test-runner
                        {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
          :main-opts   ["-m" "cognitect.test-runner"]
          :jvm-opts    ["--enable-native-access=ALL-UNNAMED"]}

  ;; one-shot import of the old EDN log into Datalevin:  clojure -M:migrate
  :migrate {:main-opts ["-m" "loci.migrate"]
            :jvm-opts  ["--enable-native-access=ALL-UNNAMED"]}

  ;; re-measure the merge threshold after changing LOCI_EMBED_MODEL — a
  ;; threshold belongs to one embedding model and does not travel:
  ;;   clojure -M:calibrate path/to/memory.edn
  ;; The path is required; there is no default, so this cannot be pointed at
  ;; your real memory by accident. It reads and never writes.
  :calibrate {:main-opts ["-m" "loci.calibrate"]
              :jvm-opts  ["--enable-native-access=ALL-UNNAMED"]}

  ;; an nREPL for editor/agent tooling (ClojureMCP starts this itself via
  ;; :start-nrepl-cmd). Deliberately WITHOUT :extra-paths ["dev"] — a REPL that
  ;; loads user.clj is one keystroke from serving Clerk over the real notebooks.
  ;; Native access because anything worth evaluating here reaches loci.dlv.
  ;;
  ;; `test` IS on the path, and that is the difference between a REPL that can
  ;; run this project's tests and one that can only look at its source. Without
  ;; it, `(require 'loci.factlog-test)` fails and every test run costs a fresh
  ;; JVM: measured 2026-08-15, ~25 s of startup (14 s of it Datalevin) to reach
  ;; work that takes milliseconds warm. `test` carries no user.clj, so it does
  ;; not reintroduce what the "dev" exclusion above is guarding against.
  ;;   clojure -M:nrepl
  :nrepl {:extra-paths ["test"]
          :extra-deps  {nrepl/nrepl {:mvn/version "1.3.1"}}
          :main-opts   ["-m" "nrepl.cmdline" "--port" "7888"]
          :jvm-opts    ["--enable-native-access=ALL-UNNAMED"]}

  ;; Clerk notebook (the earlier render target). Both reach the substrate
  ;; through notebooks/loci.clj, so both need the native-access flag too.
  :dev   {:extra-paths ["dev" "notebooks"]
          :extra-deps  {io.github.nextjournal/clerk {:mvn/version "0.17.1102"}}
          :jvm-opts    ["--enable-native-access=ALL-UNNAMED"]}
  :start {:extra-paths ["dev" "notebooks"]
          :extra-deps  {io.github.nextjournal/clerk {:mvn/version "0.17.1102"}}
          :jvm-opts    ["--enable-native-access=ALL-UNNAMED"]
          :exec-fn     user/start}

  ;; the uberjar:  clojure -T:build uber   ->  target/loci-standalone.jar
  :build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
          :ns-default build}}}
