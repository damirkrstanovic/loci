   :domain  :sciences
   :source  {:publisher "U.S. Geological Survey, National Minerals Information Center"
             :dataset   "Mineral Commodity Summaries 2026 Data Release — MCS2026_Commodities_Data.csv"
             :url       "https://www.sciencebase.gov/catalog/item/696a75d5d4be0228872d3bf8"
